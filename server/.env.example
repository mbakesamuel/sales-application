PORT=3001
HOST=0.0.0.0

# dev | prod — restart the server after changing
DB_TARGET=dev

DATABASE_URL_DEV=postgres://postgres:your_password@localhost:5432/sales_central
DATABASE_URL_PROD=postgresql://user:password@your-prod-host/neondb?sslmode=require

# Optional legacy fallback if DEV/PROD URLs are unset:
# DATABASE_URL=postgres://postgres:your_password@localhost:5432/sales_central

# Vercel (production): set in Project → Settings → Environment Variables
#   DB_TARGET=prod
#   DATABASE_URL_PROD=postgresql://...@...neon.tech/neondb?sslmode=require
#   (or a single DATABASE_URL with the same remote URL)
# Never point Vercel at localhost — health will hang until FUNCTION_INVOCATION_TIMEOUT.

# API Secret Key
API_SECRET_KEY=your-generated-secret-key-here
CORS_ORIGIN=*
