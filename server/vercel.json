{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm install --include=dev",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/print/(.*)", "destination": "/api/print" },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "{api/_app.mjs,api/handler.js}"
    },
    "api/print.js": {
      "memory": 1536,
      "maxDuration": 60,
      "includeFiles": "{api/_app.mjs,api/handler.js,node_modules/@sparticuz/chromium/bin/**}"
    }
  },
  "build": {
    "env": {
      "PUPPETEER_SKIP_DOWNLOAD": "1",
      "PUPPETEER_SKIP_CHROMIUM_DOWNLOAD": "1",
      "EXPERIMENTAL_NODE_TYPESCRIPT_ERRORS": "0",
      "VERCEL_FORCE_NO_BUILD_CACHE": "1"
    }
  }
}
