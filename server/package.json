{
  "name": "sales-sync-server",
  "version": "1.0.0",
  "description": "Central PostgreSQL Synchronization Server for Sales Management Application",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npx prisma generate && npx tsc -p tsconfig.build.json",
    "vercel-build": "node ./scripts/vercel-build.mjs",
    "start": "node dist/index.js",
    "postinstall": "npx prisma generate",
    "prisma:generate": "npx prisma generate",
    "prisma:pull": "npx prisma db pull",
    "pm2:start": "npm run build && pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop sales-sync-server",
    "pm2:restart": "pm2 restart sales-sync-server",
    "pm2:logs": "pm2 logs sales-sync-server",
    "pm2:status": "pm2 status",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:dev": "tsx src/db/migrate.ts",
    "db:reset": "tsx src/db/reset.ts",
    "db:reset:dev": "tsx src/db/reset.ts",
    "db:clear-ops": "tsx src/db/clearOperational.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@prisma/client": "5.22.0",
    "@sparticuz/chromium": "^147.0.0",
    "dotenv": "^16.4.7",
    "hono": "^4.6.14",
    "postgres": "^3.4.5",
    "prisma": "5.22.0",
    "puppeteer-core": "^25.16.0"
  },
  "optionalDependencies": {
    "puppeteer": "^25.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
